{
  "name": "trip-planner-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,green \"vite\" \"wrangler dev\"",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute trip-planner-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute trip-planner-db --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wrangler": "^3.78.0"
  }
}
